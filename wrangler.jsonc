{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "showcase",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": ["BUCKETS"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false
}
